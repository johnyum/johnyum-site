{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5310"
      ],
      "port": 5310
    },
    {
      "name": "monsters",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "monsters/serve.py"
      ],
      "port": 5320
    },
    {
      "name": "monsters-mock",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "monsters/serve.py"
      ],
      "port": 5321,
      "env": {
        "MONSTERS_MOCK": "1",
        "PORT": "5321"
      }
    },
    {
      "name": "peek",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5330"
      ],
      "port": 5330
    }
  ]
}