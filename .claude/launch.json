{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5310"
      ],
      "port": 5310
    },
    {
      "name": "monsters",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "monsters/serve.py"
      ],
      "port": 5320
    },
    {
      "name": "monsters-mock",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "monsters/serve.py"
      ],
      "port": 5321,
      "env": {
        "MONSTERS_MOCK": "1",
        "PORT": "5321"
      }
    },
    {
      "name": "peek",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-c",
        "import os, functools, http.server as h; h.ThreadingHTTPServer(('', int(os.environ.get('PORT', '5330'))), functools.partial(h.SimpleHTTPRequestHandler, directory='/Users/johnyum/Documents/johnyum-site')).serve_forever()"
      ],
      "port": 5330,
      "autoPort": true
    }
  ]
}
